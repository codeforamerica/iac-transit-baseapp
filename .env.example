# Non-sensitive configuration variables for local development
# Copy this file to .env.local and customize as needed
# Sensitive credentials (DB_USER, DB_PASSWORD) must be set via terminal exports

# Node.js Environment
NODE_ENV=development
API_PORT=3001

# Database Configuration (non-sensitive)
DB_HOST=db
DB_PORT=5432
DB_NAME=todoapp

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001
